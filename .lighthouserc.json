{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "maxAutodiscoverUrls": 0,
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox"
      },
      "autodiscoverUrlBlocklist": [
        "/404.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    }
  }
}
